# Copy to .env and fill in. Never commit .env.

# Neon: Project dashboard -> Connect -> copy the connection string (keep ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Voyage AI: dashboard.voyageai.com -> API keys
VOYAGE_API_KEY=

# LLM for answers + judge - fill whichever provider your configs use
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# dev = 20 docs / 74 questions; full = 84 docs / 150 questions
CORPUS=dev

# Client-side embedding throttle. Voyage WITHOUT a card on file: EMBED_RPM=3, EMBED_TPM=10000.
# With a card on file leave both at 0 (no client throttle; 429s are still retried).
EMBED_RPM=0
EMBED_TPM=0
